{
  "name": "voxelcore-tools",
  "displayName": "VoxelCore Content-Pack Tools",
  "description": "Schemas, linting, Lua API, VCM/VCA support, model preview and engine runner for VoxelCore content packs.",
  "version": "0.1.0",
  "publisher": "voxelcore",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MihailRis/VoxelCore.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Visualization"
  ],
  "keywords": [
    "voxelcore",
    "voxel",
    "modding",
    "content pack",
    "lua"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/*.vcm",
    "workspaceContains:**/*.vca",
    "onLanguage:vcm",
    "onLanguage:vca",
    "onCommand:voxelcore.newPack",
    "onCommand:voxelcore.configureLua",
    "onCommand:voxelcore.writeLuarc",
    "onCommand:voxelcore.openPreview",
    "onWebviewPanel:voxelcore.modelPreview",
    "onCustomEditor:voxelcore.vec3Preview",
    "onView:voxelcore.content",
    "onView:voxelcore.dependencies",
    "onView:voxelcore.engine",
    "onDebugResolve:voxelcore",
    "onDebugDynamicConfigurations:voxelcore",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vcm",
        "aliases": [
          "VoxelCore Model",
          "VCM"
        ],
        "extensions": [
          ".vcm"
        ],
        "configuration": "./languages/vcm.language-configuration.json"
      },
      {
        "id": "vca",
        "aliases": [
          "VoxelCore Animation",
          "VCA"
        ],
        "extensions": [
          ".vca"
        ],
        "configuration": "./languages/vcm.language-configuration.json"
      },
      {
        "id": "vclang",
        "aliases": [
          "VoxelCore Locale",
          "vclang"
        ],
        "filenamePatterns": [
          "**/texts/*.txt"
        ],
        "configuration": "./languages/vclang.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vcm",
        "scopeName": "source.vcm",
        "path": "./syntaxes/vcm.tmLanguage.json"
      },
      {
        "language": "vca",
        "scopeName": "source.vca",
        "path": "./syntaxes/vca.tmLanguage.json"
      },
      {
        "language": "vclang",
        "scopeName": "source.vclang",
        "path": "./syntaxes/vclang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/json.json"
      },
      {
        "language": "jsonc",
        "path": "./snippets/json.json"
      },
      {
        "language": "lua",
        "path": "./snippets/lua.json"
      },
      {
        "language": "vcm",
        "path": "./snippets/vcm.json"
      },
      {
        "language": "vca",
        "path": "./snippets/vca.json"
      }
    ],
    "commands": [
      {
        "command": "voxelcore.newPack",
        "title": "New Content Pack…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.newBlock",
        "title": "New Block…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.newItem",
        "title": "New Item…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.newEntity",
        "title": "New Entity…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.newComponent",
        "title": "New Entity Component…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.run",
        "title": "Run Engine",
        "category": "VoxelCore",
        "icon": "$(play)"
      },
      {
        "command": "voxelcore.runQuickWorld",
        "title": "Run Quick World",
        "category": "VoxelCore",
        "icon": "$(play-circle)"
      },
      {
        "command": "voxelcore.runHeadlessScript",
        "title": "Run Lua Script Headless",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.prepareUserDir",
        "title": "Link Workspace Packs into Dev User Dir",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.openLog",
        "title": "Open Engine Log (latest.log)",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.restartServer",
        "title": "Restart Language Server",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.openFile",
        "title": "Open Asset",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.previewFile",
        "title": "Preview Asset",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.debugQuickWorld",
        "title": "Debug Quick World",
        "category": "VoxelCore",
        "icon": "$(debug-alt)"
      },
      {
        "command": "voxelcore.attachDebugger",
        "title": "Attach Debugger to Running Engine",
        "category": "VoxelCore",
        "icon": "$(debug)"
      },
      {
        "command": "voxelcore.debugHeadlessScript",
        "title": "Debug Lua Script Headless",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.reloadContent",
        "title": "Reload Content in the Running Engine",
        "category": "VoxelCore",
        "icon": "$(flame)"
      },
      {
        "command": "voxelcore.explorer.refresh",
        "title": "Refresh",
        "category": "VoxelCore",
        "icon": "$(refresh)"
      },
      {
        "command": "voxelcore.explorer.copyId",
        "title": "Copy Content ID",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.explorer.openPreview",
        "title": "Open Preview",
        "category": "VoxelCore",
        "icon": "$(preview)"
      },
      {
        "command": "voxelcore.explorer.reveal",
        "title": "Reveal in Explorer View",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.explorer.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.showEngineOutput",
        "title": "Show Engine Output",
        "category": "VoxelCore",
        "icon": "$(output)"
      },
      {
        "command": "voxelcore.clearRuntimeProblems",
        "title": "Clear Engine Problems",
        "category": "VoxelCore",
        "icon": "$(clear-all)"
      },
      {
        "command": "voxelcore.configureLua",
        "title": "Configure Lua for content packs",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.writeLuarc",
        "title": "Write .luarc.json",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.findReferences",
        "title": "Find VoxelCore References",
        "category": "VoxelCore",
        "icon": "$(references)"
      },
      {
        "command": "voxelcore.renameSymbol",
        "title": "Rename Content (Files and References)...",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.showReferences",
        "title": "Show References",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.openPreview",
        "title": "Open Preview",
        "category": "VoxelCore",
        "icon": "$(preview)"
      }
    ],
    "submenus": [
      {
        "id": "voxelcore.new",
        "label": "New VoxelCore"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "voxelcore.new",
          "group": "navigation@9",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "voxelcore.findReferences",
          "when": "voxelcore.hasPacks && !explorerResourceIsFolder && resourceExtname =~ /^\\.(png|ogg|wav|vcm|obj|vec3|json|lua|xml)$/",
          "group": "4_search@9"
        },
        {
          "command": "voxelcore.renameSymbol",
          "when": "voxelcore.hasPacks && !explorerResourceIsFolder && resourceExtname =~ /^\\.(png|ogg|wav|vcm|obj|vec3|json|lua|xml)$/",
          "group": "7_modification@9"
        },
        {
          "command": "voxelcore.openPreview",
          "when": "resourceExtname == .vcm || resourceExtname == .obj || resourceExtname == .vec3 || resourceExtname == .json && resourcePath =~ /[\\\\/](blocks|entities|skeletons)[\\\\/]/",
          "group": "navigation@90"
        }
      ],
      "voxelcore.new": [
        {
          "command": "voxelcore.newPack",
          "group": "1_pack"
        },
        {
          "command": "voxelcore.newBlock",
          "group": "2_unit@1",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newItem",
          "group": "2_unit@2",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newEntity",
          "group": "2_unit@3",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newComponent",
          "group": "2_unit@4",
          "when": "voxelcore.hasPacks"
        }
      ],
      "commandPalette": [
        {
          "command": "voxelcore.newBlock",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newItem",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newEntity",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newComponent",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.runHeadlessScript",
          "when": "editorLangId == lua"
        },
        {
          "command": "voxelcore.openFile",
          "when": "false"
        },
        {
          "command": "voxelcore.previewFile",
          "when": "false"
        },
        {
          "command": "voxelcore.explorer.copyId",
          "when": "false"
        },
        {
          "command": "voxelcore.explorer.openPreview",
          "when": "false"
        },
        {
          "command": "voxelcore.explorer.reveal",
          "when": "false"
        },
        {
          "command": "voxelcore.explorer.revealInOS",
          "when": "false"
        },
        {
          "command": "voxelcore.findReferences",
          "when": "voxelcore.hasPacks && editorIsOpen"
        },
        {
          "command": "voxelcore.renameSymbol",
          "when": "voxelcore.hasPacks && editorIsOpen"
        },
        {
          "command": "voxelcore.showReferences",
          "when": "false"
        },
        {
          "command": "voxelcore.openPreview",
          "when": "resourceExtname == .vcm || resourceExtname == .obj || resourceExtname == .vec3 || activeCustomEditorId == voxelcore.vec3Preview || voxelcore.previewable"
        }
      ],
      "editor/context": [
        {
          "command": "voxelcore.runHeadlessScript",
          "group": "voxelcore",
          "when": "editorLangId == lua && voxelcore.hasPacks"
        }
      ],
      "view/title": [
        {
          "command": "voxelcore.debugQuickWorld",
          "when": "view == voxelcore.engine",
          "group": "navigation@2"
        },
        {
          "command": "voxelcore.reloadContent",
          "when": "view == voxelcore.engine",
          "group": "navigation@5"
        },
        {
          "command": "voxelcore.explorer.refresh",
          "when": "view == voxelcore.content || view == voxelcore.dependencies",
          "group": "navigation@9"
        },
        {
          "command": "voxelcore.runQuickWorld",
          "when": "view == voxelcore.engine",
          "group": "navigation@1"
        },
        {
          "command": "voxelcore.run",
          "when": "view == voxelcore.engine",
          "group": "navigation@2"
        },
        {
          "command": "voxelcore.showEngineOutput",
          "when": "view == voxelcore.engine",
          "group": "navigation@3"
        },
        {
          "command": "voxelcore.clearRuntimeProblems",
          "when": "view == voxelcore.engine",
          "group": "navigation@4"
        },
        {
          "command": "voxelcore.newPack",
          "when": "view == voxelcore.content",
          "group": "1_new"
        }
      ],
      "view/item/context": [
        {
          "command": "voxelcore.attachDebugger",
          "when": "view == voxelcore.engine && viewItem == voxelcore.engine.hotreload",
          "group": "inline"
        },
        {
          "command": "voxelcore.explorer.openPreview",
          "when": "view == voxelcore.content && viewItem =~ /\\bpreviewable\\b/",
          "group": "inline"
        },
        {
          "command": "voxelcore.explorer.openPreview",
          "when": "view == voxelcore.content && viewItem =~ /\\bpreviewable\\b/",
          "group": "1_open@1"
        },
        {
          "command": "voxelcore.explorer.copyId",
          "when": "view == voxelcore.content && (viewItem =~ /\\bid\\b/ || viewItem == voxelcore.pack)",
          "group": "2_copy@1"
        },
        {
          "command": "voxelcore.explorer.reveal",
          "when": "view == voxelcore.content && (viewItem =~ /\\bfile\\b/ || viewItem == voxelcore.pack)",
          "group": "3_reveal@1"
        },
        {
          "command": "voxelcore.newBlock",
          "when": "view == voxelcore.content && viewItem == voxelcore.pack",
          "group": "1_new@1"
        },
        {
          "command": "voxelcore.newItem",
          "when": "view == voxelcore.content && viewItem == voxelcore.pack",
          "group": "1_new@2"
        },
        {
          "command": "voxelcore.newEntity",
          "when": "view == voxelcore.content && viewItem == voxelcore.pack",
          "group": "1_new@3"
        },
        {
          "command": "voxelcore.explorer.revealInOS",
          "when": "view == voxelcore.engine && viewItem =~ /^voxelcore\\.engine\\.(exe|res|user|log)$/",
          "group": "1_reveal@1"
        },
        {
          "command": "voxelcore.openLog",
          "when": "view == voxelcore.engine && viewItem == voxelcore.engine.log",
          "group": "inline"
        },
        {
          "command": "voxelcore.findReferences",
          "when": "view == voxelcore.content && viewItem =~ /\\bfile\\b/",
          "group": "4_refs@1"
        },
        {
          "command": "voxelcore.renameSymbol",
          "when": "view == voxelcore.content && viewItem =~ /\\bfile\\b/",
          "group": "4_refs@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "voxelcore.debugHeadlessScript",
          "when": "resourceLangId == lua && voxelcore.hasPacks",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "voxelcore.openPreview",
          "when": "resourceExtname == .vcm || resourceExtname == .obj || resourceLangId == vcm || voxelcore.previewable",
          "group": "navigation"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "voxelcore",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "run",
              "quickWorld",
              "headless"
            ],
            "enumDescriptions": [
              "Start the engine with the workspace packs linked into the dev user dir",
              "Start the engine and open (or create) a dev world with the workspace packs enabled",
              "Run a Lua app script headless (--headless --script)"
            ]
          },
          "world": {
            "type": "string",
            "description": "quickWorld: world name",
            "default": "vscode-dev"
          },
          "generator": {
            "type": "string",
            "description": "quickWorld: generator id, e.g. base:demo"
          },
          "seed": {
            "type": "string",
            "description": "quickWorld: seed",
            "default": "2025"
          },
          "recreate": {
            "type": "boolean",
            "description": "quickWorld: delete and recreate the world",
            "default": false
          },
          "script": {
            "type": "string",
            "description": "headless: Lua app script path"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra engine arguments"
          }
        }
      }
    ],
    "configuration": {
      "title": "VoxelCore",
      "properties": {
        "voxelcore.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the VoxelCore executable. Empty: auto-detect `build/*/VoxelCore(.exe)` in the workspace or its ancestors. Supports `${workspaceFolder}`.",
          "scope": "machine-overridable"
        },
        "voxelcore.resPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Engine `res/` folder (the `core` pack and built-in packs such as `base`). Empty: auto-detect.",
          "scope": "machine-overridable"
        },
        "voxelcore.userDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "User dir (`--dir`) for runs started from VS Code. Workspace packs are linked into `<userDir>/content`. Empty: the extension's workspace storage.",
          "scope": "machine-overridable"
        },
        "voxelcore.gutterThumbnails": {
          "type": "boolean",
          "default": true,
          "description": "Show a texture thumbnail in the gutter next to texture references in definitions and VCM models."
        },
        "voxelcore.hotReload.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Reload saved assets, modules and content in an engine started from VS Code. Runs start with `--dbg-server` (the window title shows *[debugging]*) and the quick-world script stays running to serve reload requests."
        },
        "voxelcore.hotReload.content": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "off"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask before reloading content (it reopens the world)",
            "Reload content on every save of a definition or script",
            "Never reload content automatically"
          ],
          "description": "What to do when a block/item/entity definition, script or layout is saved while the engine runs."
        },
        "voxelcore.log.tail": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Follow `<userDir>/latest.log` to show engine output and map engine errors to the Problems panel for engines started outside VS Code with the same user dir (`voxelcore.userDir`)."
        },
        "voxelcore.configureLua": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask once per workspace before writing Lua.* settings for the Lua language server (sumneko.lua).",
            "Always configure the Lua language server in workspaces with content packs, without asking.",
            "Never change Lua.* settings automatically (the commands still work)."
          ],
          "default": "ask",
          "scope": "window",
          "markdownDescription": "Whether VoxelCore Tools configures the [Lua language server](https://marketplace.visualstudio.com/items?itemName=sumneko.lua) for content-pack workspaces: adds the engine API definitions to `Lua.workspace.library`, sets `Lua.runtime.version` to `LuaJIT`, and registers engine globals in `Lua.diagnostics.globals`."
        },
        "voxelcore.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the VoxelCore pack linter (vcls diagnostics for definitions, Lua scripts, VCM models and VCA animations)."
        },
        "voxelcore.lint.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-rule severity overrides, e.g. `{ \"VC0060\": \"off\", \"VC0020\": \"error\" }`. Run `node dist/cli.js rules` for the rule list.",
          "propertyNames": {
            "pattern": "^VC\\d{4}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "information",
              "hint",
              "off"
            ]
          }
        }
      }
    },
    "breakpoints": [
      {
        "language": "lua"
      }
    ],
    "debuggers": [
      {
        "type": "voxelcore",
        "label": "VoxelCore",
        "languages": [
          "lua"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "quickWorld",
                  "run",
                  "headless"
                ],
                "enumDescriptions": [
                  "Open the dev world with every workspace pack (like VoxelCore: Run Quick World)",
                  "Start the engine at the main menu",
                  "Run an app script without a window (set 'script')"
                ],
                "default": "quickWorld"
              },
              "world": {
                "type": "string",
                "description": "quickWorld: world name",
                "default": "vscode-dev"
              },
              "generator": {
                "type": "string",
                "description": "quickWorld: generator id, e.g. base:demo"
              },
              "seed": {
                "type": "string",
                "description": "quickWorld: seed of a new world"
              },
              "recreate": {
                "type": "boolean",
                "description": "quickWorld: delete the world first",
                "default": false
              },
              "script": {
                "type": "string",
                "description": "headless: the app script (.lua)"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra engine arguments"
              },
              "port": {
                "type": "number",
                "description": "Debugger port (default: a free one)"
              },
              "waitForDebugger": {
                "type": "boolean",
                "default": true,
                "description": "quickWorld: load content only after the breakpoints are set, so breakpoints in load-time code and on_world_open are hit"
              }
            }
          },
          "attach": {
            "properties": {
              "port": {
                "type": "number",
                "description": "Port of an engine started with --dbg-server tcp:<port>. Empty: the engine run by this window"
              },
              "host": {
                "type": "string",
                "default": "127.0.0.1"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "voxelcore",
            "request": "launch",
            "name": "VoxelCore: Debug Quick World",
            "mode": "quickWorld"
          }
        ],
        "configurationSnippets": [
          {
            "label": "VoxelCore: Debug Quick World",
            "description": "Open the dev world with the workspace packs and debug their Lua scripts",
            "body": {
              "type": "voxelcore",
              "request": "launch",
              "name": "VoxelCore: Debug Quick World",
              "mode": "quickWorld"
            }
          },
          {
            "label": "VoxelCore: Debug Headless Script",
            "description": "Run an app script without a window and debug it",
            "body": {
              "type": "voxelcore",
              "request": "launch",
              "name": "VoxelCore: Debug Headless Script",
              "mode": "headless",
              "script": "^\"\\${file}\""
            }
          },
          {
            "label": "VoxelCore: Attach",
            "description": "Attach to an engine started with --dbg-server",
            "body": {
              "type": "voxelcore",
              "request": "attach",
              "name": "VoxelCore: Attach",
              "port": 9000
            }
          }
        ]
      }
    ],

{
  "name": "voxelcore-tools",
  "displayName": "VoxelCore Content-Pack Tools",
  "description": "Schemas, linting, Lua API, VCM/VCA support, model preview and engine runner for VoxelCore content packs.",
  "version": "0.1.0",
  "publisher": "voxelcore",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MihailRis/VoxelCore.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Visualization"
  ],
  "keywords": [
    "voxelcore",
    "voxel",
    "modding",
    "content pack",
    "lua"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/*.vcm",
    "workspaceContains:**/*.vca",
    "onLanguage:vcm",
    "onLanguage:vca",
    "onCommand:voxelcore.newPack",
    "onCommand:voxelcore.configureLua",
    "onCommand:voxelcore.writeLuarc",
    "onCommand:voxelcore.openPreview",
    "onWebviewPanel:voxelcore.modelPreview",
    "onCustomEditor:voxelcore.vec3Preview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vcm",
        "aliases": [
          "VoxelCore Model",
          "VCM"
        ],
        "extensions": [
          ".vcm"
        ],
        "configuration": "./languages/vcm.language-configuration.json"
      },
      {
        "id": "vca",
        "aliases": [
          "VoxelCore Animation",
          "VCA"
        ],
        "extensions": [
          ".vca"
        ],
        "configuration": "./languages/vcm.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vcm",
        "scopeName": "source.vcm",
        "path": "./syntaxes/vcm.tmLanguage.json"
      },
      {
        "language": "vca",
        "scopeName": "source.vca",
        "path": "./syntaxes/vca.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/json.json"
      },
      {
        "language": "jsonc",
        "path": "./snippets/json.json"
      },
      {
        "language": "lua",
        "path": "./snippets/lua.json"
      },
      {
        "language": "vcm",
        "path": "./snippets/vcm.json"
      },
      {
        "language": "vca",
        "path": "./snippets/vca.json"
      }
    ],
    "commands": [
      {
        "command": "voxelcore.newPack",
        "title": "New Content Pack…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.newBlock",
        "title": "New Block…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.newItem",
        "title": "New Item…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.newEntity",
        "title": "New Entity…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.newComponent",
        "title": "New Entity Component…",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.run",
        "title": "Run Engine",
        "category": "VoxelCore",
        "icon": "$(play)"
      },
      {
        "command": "voxelcore.runQuickWorld",
        "title": "Run Quick World",
        "category": "VoxelCore",
        "icon": "$(play-circle)"
      },
      {
        "command": "voxelcore.runHeadlessScript",
        "title": "Run Lua Script Headless",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.prepareUserDir",
        "title": "Link Workspace Packs into Dev User Dir",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.openLog",
        "title": "Open Engine Log (latest.log)",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.restartServer",
        "title": "Restart Language Server",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.configureLua",
        "title": "Configure Lua for content packs",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.writeLuarc",
        "title": "Write .luarc.json",
        "category": "VoxelCore"
      },
      {
        "command": "voxelcore.openPreview",
        "title": "Open Model Preview",
        "category": "VoxelCore",
        "icon": "$(preview)"
      }
    ],
    "submenus": [
      {
        "id": "voxelcore.new",
        "label": "New VoxelCore"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "voxelcore.new",
          "group": "navigation@9",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "voxelcore.openPreview",
          "when": "resourceExtname == .vcm || resourceExtname == .obj || resourceExtname == .vec3",
          "group": "navigation@90"
        }
      ],
      "voxelcore.new": [
        {
          "command": "voxelcore.newPack",
          "group": "1_pack"
        },
        {
          "command": "voxelcore.newBlock",
          "group": "2_unit@1",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newItem",
          "group": "2_unit@2",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newEntity",
          "group": "2_unit@3",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newComponent",
          "group": "2_unit@4",
          "when": "voxelcore.hasPacks"
        }
      ],
      "commandPalette": [
        {
          "command": "voxelcore.newBlock",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newItem",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newEntity",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.newComponent",
          "when": "voxelcore.hasPacks"
        },
        {
          "command": "voxelcore.runHeadlessScript",
          "when": "editorLangId == lua"
        },
        {
          "command": "voxelcore.openPreview",
          "when": "resourceExtname == .vcm || resourceExtname == .obj || resourceExtname == .vec3 || activeCustomEditorId == voxelcore.vec3Preview"
        }
      ],
      "editor/context": [
        {
          "command": "voxelcore.runHeadlessScript",
          "group": "voxelcore",
          "when": "editorLangId == lua && voxelcore.hasPacks"
        }
      ],
      "editor/title": [
        {
          "command": "voxelcore.openPreview",
          "when": "resourceExtname == .vcm || resourceExtname == .obj || resourceLangId == vcm",
          "group": "navigation"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "voxelcore",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "run",
              "quickWorld",
              "headless"
            ],
            "enumDescriptions": [
              "Start the engine with the workspace packs linked into the dev user dir",
              "Start the engine and open (or create) a dev world with the workspace packs enabled",
              "Run a Lua app script headless (--headless --script)"
            ]
          },
          "world": {
            "type": "string",
            "description": "quickWorld: world name",
            "default": "vscode-dev"
          },
          "generator": {
            "type": "string",
            "description": "quickWorld: generator id, e.g. base:demo"
          },
          "seed": {
            "type": "string",
            "description": "quickWorld: seed",
            "default": "2025"
          },
          "recreate": {
            "type": "boolean",
            "description": "quickWorld: delete and recreate the world",
            "default": false
          },
          "script": {
            "type": "string",
            "description": "headless: Lua app script path"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra engine arguments"
          }
        }
      }
    ],
    "configuration": {
      "title": "VoxelCore",
      "properties": {
        "voxelcore.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the VoxelCore executable. Empty: auto-detect `build/*/VoxelCore(.exe)` in the workspace or its ancestors. Supports `${workspaceFolder}`.",
          "scope": "machine-overridable"
        },
        "voxelcore.resPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Engine `res/` folder (the `core` pack and built-in packs such as `base`). Empty: auto-detect.",
          "scope": "machine-overridable"
        },
        "voxelcore.userDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "User dir (`--dir`) for runs started from VS Code. Workspace packs are linked into `<userDir>/content`. Empty: the extension's workspace storage.",
          "scope": "machine-overridable"
        },
        "voxelcore.configureLua": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask once per workspace before writing Lua.* settings for the Lua language server (sumneko.lua).",
            "Always configure the Lua language server in workspaces with content packs, without asking.",
            "Never change Lua.* settings automatically (the commands still work)."
          ],
          "default": "ask",
          "scope": "window",
          "markdownDescription": "Whether VoxelCore Tools configures the [Lua language server](https://marketplace.visualstudio.com/items?itemName=sumneko.lua) for content-pack workspaces: adds the engine API definitions to `Lua.workspace.library`, sets `Lua.runtime.version` to `LuaJIT`, and registers engine globals in `Lua.diagnostics.globals`."
        },
        "voxelcore.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the VoxelCore pack linter (vcls diagnostics for definitions, Lua scripts, VCM models and VCA animations)."
        },
        "voxelcore.lint.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-rule severity overrides, e.g. `{ \"VC0060\": \"off\", \"VC0020\": \"error\" }`. Run `node dist/cli.js rules` for the rule list.",
          "propertyNames": {
            "pattern": "^VC\\d{4}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "information",
              "hint",
              "off"
            ]
          }
        }
      }
    },
    "customEditors": [
      {
        "viewType": "voxelcore.vec3Preview",
        "displayName": "VoxelCore VEC3 Model Preview",
        "selector": [
          {
            "filenamePattern": "*.vec3"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/block_materials/*.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/block-material.schema.json"
      },
      {
        "fileMatch": [
          "**/blocks/**/*.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/block.schema.json"
      },
      {
        "fileMatch": [
          "**/content/*/content.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/content.schema.json"
      },
      {
        "fileMatch": [
          "**/entities/**/*.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/entity.schema.json"
      },
      {
        "fileMatch": [
          "**/items/**/*.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/item.schema.json"
      },
      {
        "fileMatch": [
          "**/content/*/package.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/package.schema.json"
      },
      {
        "fileMatch": [
          "**/preload.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/preload.schema.json"
      },
      {
        "fileMatch": [
          "**/resource-aliases.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/resource-aliases.schema.json"
      },
      {
        "fileMatch": [
          "**/resources.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/resources.schema.json"
      },
      {
        "fileMatch": [
          "**/skeletons/*.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/skeleton.schema.json"
      },
      {
        "fileMatch": [
          "**/presets/weather/*.json",
          "!**/node_modules/**",
          "!**/.vscode/**"
        ],
        "url": "./schemas/weather-preset.schema.json"
      }
    ]
  },
  "scripts": {
    "gen": "node tools/gen-schemas.mjs && node tools/gen-lua-meta.mjs",
    "contrib": "node tools/merge-contrib.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "package": "npm run build -- --production && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --production",
    "test:vscode": "npm run build && node tools/vscode-smoke.mjs"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "luaparse": "^0.3.1",
    "pngjs": "^7.0.0",
    "smol-toml": "^1.9.1",
    "three": "^0.186.1",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
}
